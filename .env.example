# ==============================================================================
# AMBIENTE & CONFIGURAÇÕES GERAIS
# ==============================================================================
NODE_ENV=development
PORT=3005
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# BANCO DE DADOS (POSTGRESQL 16)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=shopee_whatsapp_saas
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ==============================================================================
# FILAS & CACHE (REDIS 7)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# ==============================================================================
# SEGURANÇA & CRIPTOGRAFIA
# ==============================================================================
# Chave mestra de 256 bits (32 bytes em formato hex: 64 caracteres hexadecimais)
# Gerada via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret para autenticação de usuários
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Webhook Secret para autenticar callbacks da Evolution API
EVOLUTION_WEBHOOK_SECRET=dev_webhook_secret_key_change_in_production

# ==============================================================================
# RATE LIMITING & THROTTLING
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
